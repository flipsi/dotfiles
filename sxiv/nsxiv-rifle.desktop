[Desktop Entry]
Type=Application
Name=nsxiv-rifle
Comment=Image viewer with directory browsing
Exec=/home/flipsi/bin/nsxiv-rifle %F
Terminal=false
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/png;image/tiff;image/x-bmp;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-tga;image/x-xpixmap;image/webp;image/heic;image/svg+xml;image/jp2;image/jxl;image/avif;image/heif;
Icon=nsxiv
NoDisplay=true
